#!/bin/sh

set -eu

# Fuzzy finder for the AI agent sessions ccmux tracks, deliberately built to
# behave like the window finder next to it: same vim-style modes, same preview,
# same keys, and the same MRU order so both agree on what "recent" means.
# A Copilot process can hold several sessions at once, so each one gets its own
# row and the pane's foreground session is marked.

mru_option='@window-finder-mru'

if ! command -v ccmux >/dev/null 2>&1; then
    tmux display-message 'ccmux is required for the agent finder'
    exit 1
fi

if ! command -v fzf >/dev/null 2>&1; then
    tmux display-message 'fzf is required for the agent finder'
    exit 1
fi

delimiter=$(printf '\t')
escape=$(printf '\033')
dim="${escape}[2m"
reset="${escape}[0m"

sessions_json=$(ccmux show --json 2>/dev/null || printf '[]')

# tmux owns the pane -> window mapping that ccmux has no reason to know about.
panes=$(tmux list-panes -a -F "#{pane_id}${delimiter}#{window_id}${delimiter}#{session_id}${delimiter}#{session_name}${delimiter}#{window_index}${delimiter}#{window_name}")
mru=$(tmux show-option -gqv "$mru_option" || printf '')

rows=$(
    CCMUX_JSON="$sessions_json" TMUX_PANES="$panes" MRU="$mru" \
        DELIM="$delimiter" DIM="$dim" RESET="$reset" python3 -c '
import glob
import json
import os
import sqlite3
import sys

HOME = os.path.expanduser("~")
delim = os.environ["DELIM"]
dim = os.environ["DIM"]
reset = os.environ["RESET"]

RED = "\033[31m"
YELLOW = "\033[33m"
GREEN = "\033[32m"
CYAN = "\033[36m"

# Anything asking a question outranks work in flight, which outranks idle.
ATTENTION = {"permission": "PERM", "plan": "PLAN", "question": "ASK"}

try:
    agents = json.loads(os.environ["CCMUX_JSON"] or "[]")
except ValueError:
    agents = []

if not isinstance(agents, list):
    agents = []

panes = {}
for line in os.environ["TMUX_PANES"].splitlines():
    parts = line.split(delim)
    if len(parts) >= 6:
        panes[parts[0]] = parts[1:6]

rank = {w: i for i, w in enumerate(os.environ["MRU"].split())}


def open_copilot_sessions():
    """Copilot sessions that are still open, grouped by the process holding
    them. One Copilot process can carry several sessions at once, and only the
    lock file it writes says which process a session belongs to."""
    try:
        with open(os.path.join(HOME, ".copilot/open-sessions-state.json")) as handle:
            live = json.load(handle)
    except (OSError, ValueError):
        return {}

    by_pid = {}
    for session_id, state in live.items():
        locks = glob.glob(
            os.path.join(HOME, ".copilot/session-state", session_id, "inuse.*.lock")
        )
        if not locks:
            continue
        try:
            pid = int(os.path.basename(locks[0]).split(".")[1])
        except (IndexError, ValueError):
            continue

        by_pid.setdefault(pid, []).append({
            "id": session_id,
            "working": bool(state.get("working")),
            "refreshed": state.get("refreshedAt") or "",
        })

    for entries in by_pid.values():
        entries.sort(key=lambda e: e["refreshed"], reverse=True)

    return by_pid


def copilot_titles(wanted):
    """Session titles keyed by session id. Copilot names a session from the
    conversation, which says far more about it than the directory it runs in."""
    lookup = sorted({w for w in wanted if w})
    if not lookup:
        return {}

    titles = {}
    try:
        db = os.path.join(HOME, ".copilot/session-store.db")
        # Read-only so the picker can never disturb a running session.
        conn = sqlite3.connect("file:%s?mode=ro" % db, uri=True)
        placeholders = ",".join("?" * len(lookup))
        rows = conn.execute(
            "SELECT id, summary FROM sessions WHERE id IN (%s)" % placeholders,
            lookup,
        ).fetchall()
        conn.close()
    except sqlite3.Error:
        return titles

    for session_id, summary in rows:
        summary = " ".join((summary or "").split())
        if summary:
            titles[session_id] = summary

    return titles


def last_prompt(agent):
    prompt = agent.get("lastPrompt")
    if isinstance(prompt, dict):
        prompt = prompt.get("text")
    if not prompt:
        prompts = agent.get("prompts") or []
        if prompts:
            last = prompts[-1]
            prompt = last.get("text") if isinstance(last, dict) else last
    return " ".join((prompt or "").split())


OPEN_BY_PID = open_copilot_sessions()

wanted = [a.get("nativeSessionId") for a in agents]
for entries in OPEN_BY_PID.values():
    wanted.extend(e["id"] for e in entries)
TITLES = copilot_titles(wanted)

rendered = []
for index, agent in enumerate(agents):
    pane_id = agent.get("tmuxPane") or ""
    pane = panes.get(pane_id)
    if not pane:
        continue

    window_id, tmux_session, session_name, window_index, window_name = pane
    status = (agent.get("status") or "idle").lower()
    attention = (agent.get("attentionType") or "").lower()
    agent_type = agent.get("agentType") or "agent"
    project = agent.get("project") or "?"
    branch = agent.get("gitBranch") or ""
    prompt = last_prompt(agent)

    # The session ccmux reports is the one in the foreground of that pane.
    foreground = agent.get("nativeSessionId")
    hosted = OPEN_BY_PID.get(agent.get("pid")) if agent_type.lower() == "copilot" else None
    if hosted and not foreground:
        foreground = hosted[0]["id"]

    if hosted:
        entries = hosted
    else:
        # Nothing reports sessions for this agent, so the pane is the session.
        entries = [{
            "id": foreground,
            "working": status == "working",
            "refreshed": "",
            "solo": True,
        }]

    for slot, entry in enumerate(entries):
        is_foreground = entry.get("solo") or (
            entry["id"] is not None and entry["id"] == foreground
        )

        # Only the foreground session can be the one blocked on a prompt, so
        # the pane-wide attention state belongs to it alone.
        if is_foreground and status == "waiting":
            tag, color = ATTENTION.get(attention, "WAIT"), RED
        elif entry["working"] or (is_foreground and status == "working"):
            tag, color = "BUSY", YELLOW
        else:
            tag, color = "IDLE", GREEN

        title = TITLES.get(entry["id"]) if entry["id"] else ""
        detail = title or (prompt if is_foreground else "") or agent.get("pendingTool") or ""
        if not detail and entry["id"]:
            # Copilot has not named this one yet; its id is what /resume wants.
            detail = entry["id"].split("-")[0]
        if len(detail) > 58:
            detail = detail[:57] + "\u2026"

        rendered.append({
            # Windows are ordered by when they were last visited, then the
            # foreground session leads the others sharing its process.
            "sort": (
                rank.get(window_id, 1000000 + index),
                0 if is_foreground else 1,
                -slot,
                index,
            ),
            "pane": pane_id,
            "window": window_id,
            "tmux_session": tmux_session,
            "tag": tag,
            "color": color,
            "agent": agent_type,
            "project": project,
            "branch": branch,
            "detail": detail,
            "titled": bool(title),
            "foreground": is_foreground,
            "location": "%s: %s %s" % (session_name, window_index, window_name),
        })

rendered.sort(key=lambda row: row["sort"])

if not rendered:
    sys.exit(0)

agent_width = max(len(row["agent"]) for row in rendered)
project_width = max(len(row["project"]) for row in rendered)

for row in rendered:
    # A dot marks the session a pane is actually showing; the rest are open in
    # the same process, reachable with /session once you are there.
    entry = "%s %s%-4s%s  %-*s  %-*s" % (
        "\u25cf" if row["foreground"] else " ",
        row["color"], row["tag"], reset,
        agent_width, row["agent"],
        project_width, row["project"],
    )

    if row["detail"]:
        # A named session reads as its title; anything else is just context.
        entry += "  " + (CYAN + row["detail"] + reset if row["titled"] else row["detail"])

    suffix = row["location"]
    if row["branch"]:
        suffix += "  (" + row["branch"] + ")"

    print(delim.join([
        row["pane"], row["window"], row["tmux_session"],
        entry + "  " + dim + suffix + reset,
    ]))
'
)

if [ -z "$rows" ]; then
    tmux display-message 'agent-finder: no agent sessions found'
    exit 0
fi

preview='tmux display-message -p -t {1} "#{session_name} → #{window_name}   #{pane_current_path}" && tmux capture-pane -p -e -t {1}'

# Vim-style modes. The navigation keys stay unbound while searching so that
# they type normally, and are only rebound once Esc switches to normal mode.
nav_keys='j,k,g,G,i,q'
search_prompt='agent> '
normal_prompt='normal> '
search_header='Enter: select  Esc: normal mode  Ctrl-P: preview'
normal_header='j/k: move  g/G: top/bottom  i: search  Enter: select  q/Esc: quit'
normal_mode="disable-search+change-prompt($normal_prompt)+change-header($normal_header)+rebind($nav_keys)"
search_mode="enable-search+change-prompt($search_prompt)+change-header($search_header)+unbind($nav_keys)"
# Esc enters normal mode while searching, and quits when already in normal mode.
esc_action="transform:[ \"\${FZF_PROMPT%% *}\" = 'normal>' ] && echo abort || echo '$normal_mode'"

selection=$(
    printf '%s\n' "$rows" |
        fzf \
            --ansi \
            --delimiter='\t' \
            --with-nth=4.. \
            --accept-nth=1,2,3 \
            --tiebreak=index \
            --cycle \
            --layout=reverse \
            --border \
            --preview="$preview" \
            --preview-window='right,50%,border-left,wrap' \
            --prompt="$search_prompt" \
            --header="$search_header" \
            --bind='ctrl-p:toggle-preview' \
            --bind="start:unbind($nav_keys)" \
            --bind="esc:$esc_action" \
            --bind="i:$search_mode" \
            --bind='j:down' \
            --bind='k:up' \
            --bind='g:first' \
            --bind='G:last' \
            --bind='q:abort'
) || exit 0

IFS="$delimiter" read -r pane_id window_id session_id _ <<EOF
$selection
EOF

[ -n "$window_id" ] || exit 0

tmux select-window -t "$window_id"
tmux select-pane -t "$pane_id"
tmux switch-client -t "$session_id"
