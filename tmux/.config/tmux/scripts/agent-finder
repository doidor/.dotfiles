#!/bin/sh

set -eu

# Fuzzy finder for the AI agent sessions ccmux tracks, deliberately built to
# behave like the window finder next to it: same vim-style modes, same preview,
# same keys, and the same MRU order so both agree on what "recent" means.
# One row per pane, since a pane is where a session can actually be reached.

mru_option='@window-finder-mru'

if ! command -v ccmux >/dev/null 2>&1; then
    tmux display-message 'ccmux is required for the agent finder'
    exit 1
fi

if ! command -v fzf >/dev/null 2>&1; then
    tmux display-message 'fzf is required for the agent finder'
    exit 1
fi

delimiter=$(printf '\t')
escape=$(printf '\033')
dim="${escape}[2m"
reset="${escape}[0m"

render_rows() {
    sessions_json=$(ccmux show --json 2>/dev/null || printf '[]')
    # tmux owns the pane -> window mapping that ccmux has no reason to know about.
    panes=$(tmux list-panes -a -F "#{pane_id}${delimiter}#{window_id}${delimiter}#{session_id}${delimiter}#{session_name}${delimiter}#{window_index}${delimiter}#{window_name}")
    mru=$(tmux show-option -gqv "$mru_option" || printf '')

    CCMUX_JSON="$sessions_json" TMUX_PANES="$panes" MRU="$mru" \
        DELIM="$delimiter" DIM="$dim" RESET="$reset" python3 -c '
import glob
import json
import os
import sqlite3
import subprocess
import sys

HOME = os.path.expanduser("~")
delim = os.environ["DELIM"]
dim = os.environ["DIM"]
reset = os.environ["RESET"]

RED = "\033[31m"
YELLOW = "\033[33m"
GREEN = "\033[32m"
CYAN = "\033[36m"

# Anything asking a question outranks work in flight, which outranks idle.
ATTENTION = {"permission": "PERM", "plan": "PLAN", "question": "ASK"}

try:
    agents = json.loads(os.environ["CCMUX_JSON"] or "[]")
except ValueError:
    agents = []

if not isinstance(agents, list):
    agents = []

panes = {}
for line in os.environ["TMUX_PANES"].splitlines():
    parts = line.split(delim)
    if len(parts) >= 6:
        panes[parts[0]] = parts[1:6]

rank = {w: i for i, w in enumerate(os.environ["MRU"].split())}


def session_by_pid():
    """Resolve the session actually held by each live Copilot process."""
    newest = {}
    pattern = os.path.join(HOME, ".copilot/session-state", "*", "inuse.*.lock")
    for lock in glob.glob(pattern):
        session_id = os.path.basename(os.path.dirname(lock))
        try:
            pid = int(os.path.basename(lock).split(".")[1])
            modified = os.path.getmtime(lock)
        except (IndexError, OSError, ValueError):
            continue

        if modified >= newest.get(pid, ("", 0))[1]:
            newest[pid] = (session_id, modified)

    return {pid: session for pid, (session, _) in newest.items()}


def copilot_titles(wanted):
    """Session titles keyed by session id. Copilot names a session from the
    conversation, which says far more about it than the directory it runs in."""
    lookup = sorted({w for w in wanted if w})
    if not lookup:
        return {}

    titles = {}
    try:
        db = os.path.join(HOME, ".copilot/session-store.db")
        # Read-only so the picker can never disturb a running session.
        conn = sqlite3.connect("file:%s?mode=ro" % db, uri=True)
        placeholders = ",".join("?" * len(lookup))
        rows = conn.execute(
            "SELECT id, summary FROM sessions WHERE id IN (%s)" % placeholders,
            lookup,
        ).fetchall()
        conn.close()
    except sqlite3.Error:
        return titles

    for session_id, summary in rows:
        summary = " ".join((summary or "").split())
        if summary:
            titles[session_id] = summary

    return titles


def process_children():
    """Child process ids keyed by parent process id."""
    try:
        result = subprocess.run(
            ["ps", "-axo", "pid=,ppid=,state="],
            check=True,
            stdout=subprocess.PIPE,
            text=True,
        )
    except (OSError, subprocess.SubprocessError):
        return {}

    children = {}
    for line in result.stdout.splitlines():
        try:
            pid, parent, state = line.split()
            pid, parent = int(pid), int(parent)
        except ValueError:
            continue
        if state.startswith("Z"):
            continue
        children.setdefault(parent, []).append(pid)
    return children


def has_descendants(pid):
    """Whether a Copilot process still owns any tool subprocesses."""
    try:
        return bool(PROCESS_CHILDREN.get(int(pid)))
    except (TypeError, ValueError):
        return False


def has_active_subagents(session_id):
    """Whether a session has subagents without a terminal lifecycle event."""
    if not session_id:
        return False

    path = os.path.join(HOME, ".copilot/session-state", session_id, "events.jsonl")
    active = set()
    try:
        with open(path, "rb") as events:
            for line in events:
                if b"subagent." not in line:
                    continue
                try:
                    event = json.loads(line)
                except ValueError:
                    continue

                event_type = event.get("type")
                data = event.get("data") or {}
                agent_id = event.get("agentId") or data.get("agentId")
                if not agent_id:
                    continue

                if event_type == "subagent.started":
                    active.add(agent_id)
                elif event_type in {
                    "subagent.completed",
                    "subagent.failed",
                    "subagent.cancelled",
                    "subagent.stopped",
                }:
                    active.discard(agent_id)
    except OSError:
        return False

    return bool(active)


BY_PID = session_by_pid()
PROCESS_CHILDREN = process_children()


def session_of(agent):
    if (agent.get("agentType") or "").lower() != "copilot":
        return None
    # The process lock follows resumed sessions immediately; ccmux can retain
    # the invocation id until its next reconciliation.
    return BY_PID.get(agent.get("pid")) or agent.get("nativeSessionId")


TITLES = copilot_titles(session_of(a) for a in agents)

rendered = []
for index, agent in enumerate(agents):
    pane_id = agent.get("tmuxPane") or ""
    pane = panes.get(pane_id)
    if not pane:
        continue

    window_id, tmux_session, session_name, _, window_name = pane
    status = (agent.get("status") or "idle").lower()

    session_id = session_of(agent)
    background_work = (
        has_descendants(agent.get("pid"))
        or has_active_subagents(session_id)
    )

    if status == "waiting":
        tag = ATTENTION.get((agent.get("attentionType") or "").lower(), "WAIT")
        color = RED
    elif status == "working" or background_work:
        tag, color = "BUSY", YELLOW
    else:
        tag, color = "IDLE", GREEN

    title = TITLES.get(session_id, "") if session_id else ""
    title_style = CYAN if title else dim
    title = title or "Untitled session"
    if len(title) > 60:
        title = title[:59] + "\u2026"

    rendered.append({
        # Ordered by when each window was last visited, matching the window
        # finder, so the list never reshuffles as agents change state.
        "sort": (rank.get(window_id, 1000000 + index), index),
        "pane": pane_id,
        "window": window_id,
        "tmux_session": tmux_session,
        "tag": tag,
        "color": color,
        "title": title,
        "title_style": title_style,
        "location": "%s > %s" % (session_name, window_name),
    })

rendered.sort(key=lambda row: row["sort"])

if not rendered:
    sys.exit(0)

location_width = max(len(row["location"]) for row in rendered)

for row in rendered:
    entry = "%s%-4s%s  %s%-*s%s  %s%s%s" % (
        row["color"], row["tag"], reset,
        dim, location_width, row["location"], reset,
        row["title_style"], row["title"], reset,
    )

    print(delim.join([
        row["pane"], row["window"], row["tmux_session"],
        entry,
    ]))
'
}

if [ "${1:-}" = "rows" ]; then
    render_rows
    exit 0
fi

rows=$(render_rows)

if [ -z "$rows" ]; then
    tmux display-message 'agent-finder: no agent sessions found'
    exit 0
fi

preview="$HOME/.config/tmux/scripts/pane-preview {1}"
# Status and generated titles can both change while the picker stays open.
refresh="$HOME/.config/tmux/scripts/agent-finder rows"

# Vim-style modes. The navigation keys stay unbound while searching so that
# they type normally, and are only rebound once Esc switches to normal mode.
nav_keys='j,k,g,G,i,q'
search_prompt='agent> '
normal_prompt='normal> '
search_header='Enter: select  Esc: normal mode  Ctrl-P: preview'
normal_header='j/k: move  g/G: top/bottom  i: search  Enter: select  q/Esc: quit'
normal_mode="disable-search+change-prompt($normal_prompt)+change-header($normal_header)+rebind($nav_keys)"
search_mode="enable-search+change-prompt($search_prompt)+change-header($search_header)+unbind($nav_keys)"
# Esc enters normal mode while searching, and quits when already in normal mode.
esc_action="transform:[ \"\${FZF_PROMPT%% *}\" = 'normal>' ] && echo abort || echo '$normal_mode'"

selection=$(
    printf '%s\n' "$rows" |
        fzf \
            --ansi \
            --delimiter='\t' \
            --with-nth=4.. \
            --accept-nth=1,2,3 \
            --id-nth=1 \
            --track \
            --tiebreak=index \
            --cycle \
            --layout=reverse \
            --border \
            --preview="$preview" \
            --preview-window='right,65%,border-left,wrap,wrap-word,follow,~2,<120(down,60%,border-top,wrap,wrap-word,follow,~2)' \
            --prompt="$search_prompt" \
            --header="$search_header" \
            --bind='ctrl-p:toggle-preview' \
            --bind='change:first' \
            --bind="every(5):reload($refresh)" \
            --bind="start:unbind($nav_keys)" \
            --bind="esc:$esc_action" \
            --bind="i:$search_mode" \
            --bind='j:down' \
            --bind='k:up' \
            --bind='g:first' \
            --bind='G:last' \
            --bind='q:abort'
) || exit 0

IFS="$delimiter" read -r pane_id window_id session_id _ <<EOF
$selection
EOF

[ -n "$window_id" ] || exit 0

tmux select-window -t "$window_id"
tmux select-pane -t "$pane_id"
tmux switch-client -t "$session_id"
